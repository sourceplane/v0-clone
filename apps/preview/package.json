  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
